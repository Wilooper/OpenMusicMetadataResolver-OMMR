# Copy to a private file: chmod 600 .env
# Then set OMMR_ENV_FILE=.env when starting the server.
OMMR_SPOTIFY_CLIENT_ID=
OMMR_SPOTIFY_CLIENT_SECRET=
OMMR_APPLE_DEVELOPER_TOKEN=
OMMR_APPLE_STOREFRONT=us
OMMR_YTMUSIC_COOKIE_FILE=
OMMR_AMAZON_MUSIC_TOKEN=
OMMR_AMAZON_MUSIC_API_KEY=
# Amazon Music V2 uses https://api.music.amazon.com (fixed host).

OMMR_PROVIDER_TIMEOUT=10s
OMMR_CACHE_TTL=24h
OMMR_ENABLE_ENRICHMENT=true
OMMR_LASTFM_API_KEY=
OMMR_DISCOGS_TOKEN=
OMMR_ACOUSTID_API_KEY=
OMMR_QOBUZ_APP_ID=
OMMR_QOBUZ_TOKEN=
OMMR_TIDAL_TOKEN=
OMMR_PANDORA_TOKEN=
# Optional JSON string, e.g. {"mode":"consensus","priorities":{"title":["musicbrainz","spotify"]}}
OMMR_METADATA_POLICY=

# Optional explicit private session paths (otherwise use credentials_dir discovery):
# OMMR_SPOTIFY_SESSION_FILE=/private/spotify.session.json
# OMMR_APPLEMUSIC_SESSION_FILE=/private/applemusic.session.json
# OMMR_YTMUSIC_SESSION_FILE=/private/ytmusic.session.json
# OMMR_CREDENTIALS_DIR=/private/credentials
# OMMR_APPLE_MUSIC_USER_TOKEN=
# OMMR_API_DEFAULT_OPERATION=resolve
# OMMR_API_ALLOW_DEBUG=false
